APP_NAME=SolBot API
ENVIRONMENT=development
LOG_LEVEL=INFO

# Get this from your Neon project dashboard (Connection Details).
# Must include sslmode=require for Neon.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Get this from openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-oss-20b:free

# Generate your own with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reuse the value from any other project/example.
JWT_SECRET_KEY=change-me-to-a-random-secret

# Comma-separated origins allowed to call this API from a browser.
# Add your deployed frontend's origin here once you have one.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Gmail SMTP for the welcome email. SMTP_PASSWORD must be a Google
# "App Password" (myaccount.google.com/apppasswords), not your real
# Gmail password -- Gmail rejects plain password SMTP login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=youraddress@gmail.com
